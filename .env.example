# ---- Public (safe for the browser) ----
# Supabase: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key only. NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted as an older name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Your deployed address, e.g. https://learn.example.com (used for links, sitemap and share images)
NEXT_PUBLIC_SITE_URL=
# Shown on the Privacy Policy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional privacy-friendly analytics (Plausible). Leave empty to turn analytics off.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ---- Server only: never prefix with NEXT_PUBLIC_, never import from client components ----
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
